# Copy this file to ".env" (same folder) and fill in your values.
# NEVER share or upload your real .env: it contains your secret API key.

# From platform.openai.com > API keys
OPENAI_API_KEY=sk-paste-your-key-here

# Which OpenAI model writes the drafts. If you get "model not found",
# check platform.openai.com/docs/models and put a current "mini" model name here.
OPENAI_MODEL=gpt-5.4-mini

# Your name, exactly as the AI should think of you.
OWNER_NAME=Stanley

# A few honest lines about how you text (optional but helpful).
OWNER_ABOUT=I keep replies short. With friends I mix Bangla and English (Banglish, Latin letters). With work contacts I write polite English.

# Auto-send only if the AI is at least this confident (0 to 1) AND auto_reply is on for that contact.
AUTO_SEND_MIN_CONFIDENCE=0.85
